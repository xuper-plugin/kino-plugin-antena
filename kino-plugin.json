{
  "id": "antena",
  "name": "Antena",
  "version": "0.3.6",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Tu TV en vivo: canales y guía de programación desde cualquier servidor Xtream Codes.",
  "hosts": [
    "raw.githubusercontent.com",
    { "host": "redworld.pro", "insecureHttp": true },
    { "host": "myultratv.com", "insecureHttp": true }
  ],
  "capabilities": ["channels", "home", "search", "resolve"],
  "liveStreamHosts": "any",
  "categories": ["live"],
  "color": "#1A73E8",
  "secrets": {
    "serverKey": {
      "seal": "kino-sealed:v1:pw6Sc-3_tJ0NN2fHU2JtmwtSZRj8CMzEkltIgGvsPiroCssfIvqL8vw5W6ljHNoFE0pONb1oJzQQ61k_DR821ynq7xFiie6WhGQPoqOQLZHk3D2Aq91YuUeQxy0",
      "use": "cipher-key",
      "encoding": "hex"
    }
  },
  "settings": [
    {
      "key": "modeSection",
      "type": "section",
      "label": "Modo"
    },
    {
      "key": "mode",
      "type": "select",
      "label": "Fuente del servidor",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automático (recomendado)" },
        { "value": "custom", "label": "Mi propio servidor" }
      ],
      "hint": "Automático usa servidores incluidos. Propio: llena los datos abajo."
    },
    {
      "key": "serverSection",
      "type": "section",
      "label": "Servidor propio"
    },
    {
      "key": "server",
      "type": "url",
      "label": "URL del servidor",
      "hint": "Solo en modo Servidor propio. Ej: http://miiptv.com:8880"
    },
    {
      "key": "username",
      "type": "text",
      "label": "Usuario"
    },
    {
      "key": "password",
      "type": "password",
      "label": "Contraseña"
    },
    {
      "key": "liveFormat",
      "type": "select",
      "label": "Formato de los canales",
      "default": "m3u8",
      "options": [
        { "value": "m3u8", "label": "HLS (m3u8)" },
        { "value": "ts", "label": "MPEG-TS (ts)" }
      ],
      "hint": "Si un canal no abre, prueba el otro formato."
    },
    {
      "key": "statusSection",
      "type": "section",
      "label": "Estado"
    },
    {
      "key": "accountStatus",
      "type": "status",
      "label": "Cuenta"
    },
    {
      "key": "checkConn",
      "type": "action",
      "label": "Verificar conexión"
    }
  ]
}
